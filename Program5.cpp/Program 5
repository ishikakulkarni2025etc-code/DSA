//PART A
#include<stdio.h>
#define MAX 5
int stack[MAX];
int top=-1;
void push(int value)
{
if(top==MAX-1)
{
printf("Stack Overflow!Cannot push%d.\n",value);
}
else
{
stack[++top]=value;
printf("Pushed %d to stack.\n",value);
}
}
void pop() {
if (top==-1){
printf("Stack underflow!Cannot pop.\n");
}else {
printf("Popped %d from the stack.\n",stack[top--]);
}
}
void peek()
{
if (top==-1)
{
printf("Stack is empty.\n");
}
else
{
printf("Top element is %d.\n", stack[top]);
}

}
void display() {
if (top == -1) {
printf("Stack is empty.\n");
return;
}
printf("Stack elements (from top to bottom): ");
for (int i = top; i >= 0; i--) {
printf("%d ", stack[i]);
}
printf("\n");
}
int main()
{
push(1);
push(2);
push(3);
peek();
pop();
display ();
return 0;
}

//PART B
#include <stdio.h>
#define MAX 100
int queue[MAX];
int front = 0, rear = -1;
void enqueue(int n)
{
if (rear == MAX - 1)
{
printf("The Queue is full\n");
}
else
{
queue[++rear] = n;
}
}
void dequeue()
{
if (front > rear)
{
printf("The Queue is empty\n");
}
else
{
printf("Dequeued value from queue: %d\n", queue[front++]);
}
}
void display()
{
int i;
if (front > rear)
{
printf("The Queue is empty\n");
}

else
{
printf("Queue elements are: ");
for (i = front; i <= rear; i++)
{
printf("%d ", queue[i]);
}
printf("\n");
}
}
int main()
{
int n, i, value;
printf("Enter number of elements in Queue: ");
scanf("%d", &n);
if (n > MAX)
{
printf("Maximum queue size is %d\n", MAX);
return 1;
}
for (i = 0; i < n; i++)
{
printf("Enter element %d: ", i + 1);
scanf("%d", &value);
enqueue(value);
}
printf("Queue before dequeue \n");
display();
dequeue();
printf("Queue after dequeue \n");
display();
return 0;
}
