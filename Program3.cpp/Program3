void swap(int *a, int *b)
{
int temp = *a;
*a = *b;
*b = temp;
}
void bubblesort(int input[], int output[], int n)
{
int i, j;
for (i = 0; i < n; i++) output[i] = input[i];
for (i = 0; i < n - 1; i++)
{
for (j = 0; j < n - 1 - i; j++)
{
if (output[j] > output[j + 1])
{
swap(&output[j], &output[j + 1]);
}
}
}
}
void selectionsort(int input[], int output[], int n)
{
int i, j, minindex;
for (i = 0; i < n; i++) output[i] = input[i];
for (i = 0; i < n - 1; i++)
{
minindex = i;
for (j = i + 1; j < n; j++)
{
if (output[j] < output[minindex])
{
minindex = j;
}
}
swap(&output[i], &output[minindex]);

}
}
void insertionsort(int input[], int output[], int n)
{
int i, j, key;
for (i = 0; i < n; i++) output[i] = input[i];
for (i = 1; i < n; i++)
{
key = output[i];
j = i - 1;
while (j >= 0 && output[j] > key)
{
output[j + 1] = output[j];
j--;
}
output[j + 1] = key;
}
}
int partition(int input[], int l, int h)
{
int pivot = input[h];
int i = l - 1, j;
for (j = l; j < h; j++)
{
if (input[j] < pivot)
{
i++;
swap(&input[i], &input[j]);
}
}
swap(&input[i + 1], &input[h]);
return (i + 1);
}
void quicksort(int input[], int output[], int l, int h)
{
int i;
if (l == 0 && h >= 0 && input != output)
{
for (i = 0; i <= h; i++) output[i] = input[i];
}
if (l < h)
{
int pi = partition(output, l, h);
quicksort(output, output, l, pi - 1);
quicksort(output, output, pi + 1, h);
}
}

void merge(int arr[], int l, int m, int r)
{
int i, j, k;
int n1 = m - l + 1;
int n2 = r - m;
int L[n1], R[n2];
for (i = 0; i < n1; i++) L[i] = arr[l + i];
for (j = 0; j < n2; j++) R[j] = arr[m + 1 + j];
i = 0;
j = 0;
k = l;
while (i < n1 && j < n2)
{
if (L[i] <= R[j])
{
arr[k] = L[i];
i++;
}
else
{
arr[k] = R[j];
j++;
}
k++;
}
while (i < n1)
{
arr[k] = L[i];
i++;
k++;
}
while (j < n2)
{
arr[k] = R[j];
j++;
k++;
}
}
void mergesort(int input[], int output[], int l, int h)
{
int i;
if (l == 0 && h >= 0 && input != output)
{

for (i = 0; i <= h; i++) output[i] = input[i];
}
if (l < h)
{
int m = l + (h - l) / 2;
mergesort(output, output, l, m);
mergesort(output, output, m + 1, h);
merge(output, l, m, h);
}
}
